-- NUMBER INPUT
--==================================================

local function createInput(
    parent,
    text,
    description,
    value,
    minValue,
    maxValue,
    callback,
    y
)

    local holder = Instance.new("Frame")
    holder.Position = UDim2.new(0, 0, 0, y)
    holder.Size = UDim2.new(1, 0, 0, 58)
    holder.BackgroundColor3 = COLORS.Card
    holder.BorderSizePixel = 0
    holder.Parent = parent

    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 16, 0, 8)
    label.Size = UDim2.new(0, 145, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.White
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local desc = Instance.new("TextLabel")
    desc.Position = UDim2.new(0, 16, 0, 28)
    desc.Size = UDim2.new(0, 180, 0, 16)
    desc.BackgroundTransparency = 1
    desc.Text = description
    desc.TextColor3 = COLORS.Muted
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 8
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = holder

    local box = Instance.new("TextBox")
    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, -16, 0.5, 0)
    box.Size = UDim2.fromOffset(90, 31)
    box.BackgroundColor3 = COLORS.Panel2
    box.BorderSizePixel = 0
    box.Text = tostring(value)
    box.TextColor3 = COLORS.RedBright
    box.Font = Enum.Font.GothamBold
    box.TextSize = 10
    box.ClearTextOnFocus = false
    box.Parent = holder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = box

    local stroke = Instance.new("UIStroke")
    stroke.Color = COLORS.Stroke
    stroke.Thickness = 1
    stroke.Parent = box

    local currentValue = value

    box.Focused:Connect(function()

        TweenService:Create(
            stroke,
            TweenInfo.new(0.15),
            {
                Color = COLORS.Red
            }
        ):Play()

    end)

    box.FocusLost:Connect(function()

        TweenService:Create(
            stroke,
            TweenInfo.new(0.15),
            {
                Color = COLORS.Stroke
            }
        ):Play()

        local number = tonumber(box.Text)

        if number then

            number = math.clamp(
                number,
                minValue,
                maxValue
            )

            currentValue = number
            box.Text = tostring(number)

            callback(number)

        else

            box.Text = tostring(currentValue)

        end

    end)

    return holder
end

