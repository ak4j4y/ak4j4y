local espObjects = {}

local function destroyESP(targetPlayer)

    local container = espObjects[targetPlayer]

    if container then

        if container.Parent then
            container:Destroy()
        end

        espObjects[targetPlayer] = nil

    end

end

local function getESPFolder(targetPlayer)

    local folder = Instance.new("Folder")
    folder.Name = "SakuraESP_" .. targetPlayer.UserId

    -- Everything related to this player's ESP lives
    -- inside this one container.
    folder.Parent = gui

    return folder
end

