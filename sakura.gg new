--==================================================
-- SKELETON
--==================================================

local function createBeam(
    partA,
    partB,
    folder
)

    if not partA or not partB then
        return
    end

    local attachmentA = Instance.new("Attachment")
    attachmentA.Name = "SakuraA"
    attachmentA.Parent = folder

    local attachmentB = Instance.new("Attachment")
    attachmentB.Name = "SakuraB"
    attachmentB.Parent = folder

    -- Move the attachments to the body parts through
    -- WorldPosition rather than parenting them directly
    -- to the character parts.
    attachmentA.WorldPosition = partA.Position
    attachmentB.WorldPosition = partB.Position

    local beam = Instance.new("Beam")
    beam.Name = "SkeletonBeam"

    beam.Attachment0 = attachmentA
    beam.Attachment1 = attachmentB

    beam.FaceCamera = true

    beam.Width0 = 0.045
    beam.Width1 = 0.045

    beam.Color = ColorSequence.new(
        COLORS.RedBright
    )

    beam.Transparency = NumberSequence.new(0.05)

    beam.Enabled = Settings.SkeletonESP
    beam.Parent = folder

    -- Keep attachments synced to body parts.
    local connection

    connection = RunService.RenderStepped:Connect(function()

        if not folder.Parent
            or not partA.Parent
            or not partB.Parent then

            if connection then
                connection:Disconnect()
            end

            return
        end

        attachmentA.WorldPosition = partA.Position
        attachmentB.WorldPosition = partB.Position

    end)

end

local function createSkeleton(
    character,
    folder
)

    local connections

    if character:FindFirstChild("UpperTorso") then
        connections = R15Connections
    else
        connections = R6Connections
    end

    for _, connection in ipairs(connections) do

        local partA = character:FindFirstChild(
            connection[1]
        )

        local partB = character:FindFirstChild(
            connection[2]
        )

        if partA and partB then

            createBeam(
                partA,
                partB,
                folder
            )

        end

    end

end

