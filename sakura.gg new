local function buildESP(targetPlayer)

    if targetPlayer == player then
        return
    end

    destroyESP(targetPlayer)

    local character = targetPlayer.Character

    if not character then
        return
    end

    local humanoid = getHumanoid(character)

    if not humanoid then
        return
    end

    local folder = getESPFolder(targetPlayer)

    espObjects[targetPlayer] = folder

    createBillboard(
        character,
        targetPlayer,
        folder
    )

    createSkeleton(
        character,
        folder
    )

end

--==================================================
-- UPDATE ESP VISIBILITY
--==================================================

local function updateESP()

    for targetPlayer, folder in pairs(espObjects) do

        if not targetPlayer.Parent then

            destroyESP(targetPlayer)

        elseif not targetPlayer.Character then

            destroyESP(targetPlayer)

        elseif not folder.Parent then

            buildESP(targetPlayer)

        else

            for _, object in ipairs(folder:GetChildren()) do

                if object:IsA("BillboardGui") then

                    object.Enabled =
                        Settings.UsernameESP

                elseif object:IsA("Beam") then

                    object.Enabled =
                        Settings.SkeletonESP

                end

            end

        end

    end

end

