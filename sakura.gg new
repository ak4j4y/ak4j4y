--==================================================
-- NAVIGATION
--==================================================

local function showPage(name)

    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end

    for buttonName, data in pairs(navButtons) do

        if buttonName == name then

            data.Button.BackgroundTransparency = 0
            data.Button.BackgroundColor3 = COLORS.RedDark
            data.Label.TextColor3 = COLORS.White
            data.Icon.TextColor3 = COLORS.RedBright

        else

            data.Button.BackgroundTransparency = 1
            data.Label.TextColor3 = COLORS.Gray
            data.Icon.TextColor3 = COLORS.Muted

        end

    end

end

local function createNavButton(text, icon, y)

    local button = Instance.new("TextButton")
    button.Position = UDim2.new(0, 16, 0, y)
    button.Size = UDim2.new(1, -32, 0, 42)
    button.BackgroundColor3 = COLORS.Card
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = button

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Position = UDim2.new(0, 13, 0, 0)
    iconLabel.Size = UDim2.new(0, 25, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextColor3 = COLORS.Muted
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.TextSize = 13
    iconLabel.Parent = button

    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 44, 0, 0)
    label.Size = UDim2.new(1, -50, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.Gray
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    navButtons[text] = {
        Button = button,
        Label = label,
        Icon = iconLabel,
    }

    button.MouseEnter:Connect(function()

        if not pages[text].Visible then

            TweenService:Create(
                button,
                TweenInfo.new(0.12),
                {
                    BackgroundTransparency = 0,
                    BackgroundColor3 = COLORS.Card,
                }
            ):Play()

        end

    end)

    button.MouseLeave:Connect(function()

        if not pages[text].Visible then

            TweenService:Create(
                button,
                TweenInfo.new(0.12),
                {
                    BackgroundTransparency = 1,
                }
            ):Play()

        end

    end)

    button.MouseButton1Click:Connect(function()
        showPage(text)
    end)

end

