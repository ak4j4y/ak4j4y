--==================================================
-- RENDER LOOP
--==================================================

RunService.RenderStepped:Connect(
    function(deltaTime)

        camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        --==========================================
        -- FOV
        --==========================================

        fovCircle.Visible =
            Settings.FOVEnabled

        if Settings.FOVEnabled then

            fovCircle.Position =
                UDim2.fromOffset(
                    camera.ViewportSize.X / 2,
                    camera.ViewportSize.Y / 2
                )

            fovCircle.Size =
                UDim2.fromOffset(
                    Settings.FOVRadius * 2,
                    Settings.FOVRadius * 2
                )

        end

        --==========================================
        -- AIMBOT
        --==========================================

        if Settings.Aimbot
            and Settings.AimHeld then

            if not currentTarget then

                currentTarget =
                    getClosestTarget()

            end

            if currentTarget then

                local character =
                    currentTarget.Character

                local humanoid =
                    getHumanoid(character)

                local aimPart =
                    getAimPart(character)

                if not humanoid
                    or humanoid.Health <= 0
                    or not aimPart then

                    currentTarget =
                        getClosestTarget()

                end

            end

            if currentTarget then

                aimAt(
                    currentTarget,
                    deltaTime
                )

            end

        end

    end
)

