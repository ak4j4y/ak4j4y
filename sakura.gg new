--==================================================
-- TARGET SELECTION
--==================================================

local function getClosestTarget()

    local myCharacter =
        getCharacter()

    if not myCharacter then
        return nil
    end

    camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local center =
        Vector2.new(
            camera.ViewportSize.X / 2,
            camera.ViewportSize.Y / 2
        )

    local closest = nil
    local closestDistance = math.huge

    for _, targetPlayer in ipairs(
        Players:GetPlayers()
    ) do

        if targetPlayer ~= player then

            local character =
                targetPlayer.Character

            local humanoid =
                getHumanoid(character)

            local aimPart =
                getAimPart(character)

            if humanoid
                and humanoid.Health > 0
                and aimPart then

                local screenPosition, visible =
                    camera:WorldToViewportPoint(
                        aimPart.Position
                    )

                if visible
                    and screenPosition.Z > 0 then

                    local point =
                        Vector2.new(
                            screenPosition.X,
                            screenPosition.Y
                        )

                    local distance =
                        (point - center).Magnitude

                    local allowedDistance

                    if Settings.FOVEnabled then

                        allowedDistance =
                            Settings.FOVRadius

                    else

                        allowedDistance =
                            math.huge

                    end

                    if distance <= allowedDistance
                        and distance < closestDistance then

                        closestDistance =
                            distance

                        closest =
                            targetPlayer

                    end

                end

            end

        end

    end

    return closest
end

--==================================================
-- AIM
--==================================================

local function aimAt(
    targetPlayer,
    deltaTime
)

    if not targetPlayer then
        return
    end

    local character =
        targetPlayer.Character

    local humanoid =
        getHumanoid(character)

    local aimPart =
        getAimPart(character)

    if not humanoid
        or humanoid.Health <= 0
        or not aimPart then

        return
    end

    camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local predicted =
        aimPart.Position
        + (
            aimPart.AssemblyLinearVelocity
            * Settings.Prediction
        )

    local cameraPosition =
        camera.CFrame.Position

    local desired =
        CFrame.lookAt(
            cameraPosition,
            predicted
        )

    local alpha =
        1 - math.exp(
            -math.clamp(
                Settings.Smoothness,
                0.01,
                1
            )
            * 12
            * deltaTime
        )

    camera.CFrame =
        camera.CFrame:Lerp(
            desired,
            alpha
        )

end

